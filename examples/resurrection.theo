meta {
    title: "Historical Case for the Resurrection"
    author: "Portfolio Developer"
    version: 1.0
}

axiom A1 = scripture(1Corinthians, 15, 3, 8)
axiom A2 = scripture(Luke, 24, 36, 43)

premise P1 {
    text: "Jesus died by Roman crucifixion and was buried in a known tomb."
}

premise P2 {
    text: "Multiple independent sources report the tomb was found empty shortly after."
    supports: [A1]
}

conclusion C1 {
    text: "God raised Jesus from the dead as the best historical explanation of the data."
    depends_on: [P1, P2]
}