// ==========================================
// Title: The First Way (Cosmological Argument)
// Author: Thomas Aquinas (Formalized)
// ==========================================

title: "The First Way: Argument from Motion"
author: "Thomas Aquinas"

// Philosophical and Scriptural Axioms
axiom UnmovedMoverAx = scripture(Psalm, 102, 25, 27)
axiom SustainingWordAx = scripture(Hebrews, 1, 3, 3)

premise P1 {
    text: "Certain things in the world are in motion or undergoing change, and potentiality is brought to actuality only by something already actual."
    supports: []
}

premise P2 {
    text: "Whatever is moved must be moved by another; an infinite regress of actual movers is metaphysically impossible."
    supports: [P1]
}

deduction D1 {
    text: "Therefore, it is necessary to arrive at a first mover, put in motion by no other, which all men understand to be God."
    supports: [P1, P2]
    depends_on: [P1, P2]
}

conclusion C1 {
    text: "An Unmoved Mover (God) necessarily exists as the ultimate source of all change and actuality in the universe."
    supports: [D1]
    depends_on: [D1]
}