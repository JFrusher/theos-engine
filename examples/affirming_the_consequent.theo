// Deliberately invalid: `theosc check` rejects it and shows a counterexample
// (Rain = false, Wet = true: the street can be wet without rain).

argument "Affirming the Consequent"

axiom Obs = source("Field notes", "p. 4")

premise P1 grounded_by [Obs] {
    text:    "If it rains, the street is wet."
    formula: Rain -> Wet
}

premise P2 grounded_by [Obs] {
    text:    "The street is wet."
    formula: Wet
}

conclusion C1 from [P1, P2] {
    text:    "It rains."
    formula: Rain
}
